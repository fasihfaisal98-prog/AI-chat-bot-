PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local instance)
MONGODB_URI=mongodb://127.0.0.1:27017/nexa_ai

# JWT Secret Key (Use a strong, 64+ char random string in production)
JWT_SECRET=nexa_ai_super_secret_jwt_key_change_in_production_9876543210
JWT_EXPIRES_IN=7d

# Allowed Frontend Client Origin
CLIENT_URL=http://localhost:5173

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
